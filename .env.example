# IncuBrix Multi-Channel Lead Generation & Outreach Engine
# Environment Configuration Template
# Copy this file to .env and insert your API credentials if available.

# Optional: Google Gemini API Key for dynamic LLM hook generation & need classification
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: YouTube Data API v3 Key (Public RSS feeds work without key)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Engine Execution Defaults
OUTPUT_DIR=output
LOG_DIR=logs
DEFAULT_LEAD_LIMIT=1000
PRIORITY_A_LIMIT=25
